@model List<ContractClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold text-dark mb-1">
                        <i class="fas fa-user-cog me-2 text-success"></i>Academic Manager Dashboard
                    </h2>
                    <p class="text-muted">Final approval and comprehensive system oversight</p>
                </div>
                <div class="btn-group">
                    <button class="btn btn-success btn-action" onclick="generateReport()">
                        <i class="fas fa-chart-pie me-2"></i>Generate Report
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Overview -->
    <div class="row mb-4">
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-primary">@Model.Count</div>
                <div class="stat-label">Total Claims</div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-success">@Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Approved)</div>
                <div class="stat-label">Approved</div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-warning">@Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Pending)</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-info">@Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.UnderReview)</div>
                <div class="stat-label">Under Review</div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-danger">@Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Rejected)</div>
                <div class="stat-label">Rejected</div>
            </div>
        </div>
        <div class="col-md-2 mb-3">
            <div class="stat-card">
                <div class="stat-number text-secondary">@Model.Sum(c => c.Amount).ToString("C")</div>
                <div class="stat-label">Total Amount</div>
            </div>
        </div>
    </div>

    <!-- Charts and Reports Section -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="stat-card h-100">
                <h5 class="fw-bold mb-3"><i class="fas fa-chart-bar me-2 text-primary"></i>Claims by Status</h5>
                <div class="chart-container" style="height: 200px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="stat-card h-100">
                <h5 class="fw-bold mb-3"><i class="fas fa-calendar me-2 text-warning"></i>Monthly Trend</h5>
                <div class="chart-container" style="height: 200px;">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Claims Overview Table -->
    <div class="claims-table">
        <div class="table-responsive">
            <table class="table table-hover" id="managerClaimsTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-user me-2"></i>Lecturer</th>
                        <th><i class="fas fa-calendar me-2"></i>Month</th>
                        <th><i class="fas fa-dollar-sign me-2"></i>Amount</th>
                        <th><i class="fas fa-file-alt me-2"></i>Description</th>
                        <th><i class="fas fa-tag me-2"></i>Status</th>
                        <th><i class="fas fa-calendar-plus me-2"></i>Submitted</th>
                        <th><i class="fas fa-history me-2"></i>Last Action</th>
                        <th><i class="fas fa-cog me-2"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@claim.LecturerName</div>
                                <small class="text-muted">@claim.LecturerEmail</small>
                            </td>
                            <td class="fw-semibold">@claim.ClaimMonth.ToString("MMM yyyy")</td>
                            <td class="fw-bold text-success">@claim.Amount.ToString("C")</td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width: 150px;"
                                      data-bs-toggle="tooltip" title="@claim.Description">
                                    @claim.Description
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-@claim.Status.ToString().ToLower()">
                                    <i class="fas @GetStatusIcon(claim.Status) me-1"></i>@claim.Status
                                </span>
                            </td>
                            <td>@claim.SubmittedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (claim.ApprovedDate.HasValue)
                                {
                                    <small class="text-success">Approved: @claim.ApprovedDate.Value.ToString("MMM dd")</small>
                                }
                                else if (claim.ReviewedDate.HasValue)
                                {
                                    <small class="text-warning">Reviewed: @claim.ReviewedDate.Value.ToString("MMM dd")</small>
                                }
                                else
                                {
                                    <small class="text-muted">No action yet</small>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    @if (claim.Status == ContractClaimSystem.Models.ClaimStatus.UnderReview)
                                    {
                                        <form asp-controller="Claims" asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@claim.Id" />
                                            <input type="hidden" name="status" value="@ContractClaimSystem.Models.ClaimStatus.Approved" />
                                            <button type="submit" class="btn btn-sm btn-success btn-action me-1"
                                                    data-bs-toggle="tooltip" title="Final Approval">
                                                <i class="fas fa-gavel me-1"></i>Approve
                                            </button>
                                        </form>
                                        <button class="btn btn-sm btn-info btn-action"
                                                data-bs-toggle="modal"
                                                data-bs-target="#claimDetailsModal"
                                                onclick="loadClaimDetails(@claim.Id)">
                                            <i class="fas fa-info-circle me-1"></i>Details
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-info btn-action"
                                                data-bs-toggle="modal"
                                                data-bs-target="#claimDetailsModal"
                                                onclick="loadClaimDetails(@claim.Id)">
                                            <i class="fas fa-eye me-1"></i>View
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- System Reports Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="stat-card">
                <h4 class="fw-bold mb-4"><i class="fas fa-chart-line me-2 text-primary"></i>System Reports</h4>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="text-center p-3 border rounded">
                            <i class="fas fa-users fa-2x text-primary mb-2"></i>
                            <h5>Lecturer Activity</h5>
                            <p class="text-muted">View submission patterns by lecturer</p>
                            <button class="btn btn-outline-primary btn-sm" onclick="viewLecturerReport()">
                                Generate Report
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center p-3 border rounded">
                            <i class="fas fa-money-bill-wave fa-2x text-success mb-2"></i>
                            <h5>Financial Summary</h5>
                            <p class="text-muted">Total claims and amounts by period</p>
                            <button class="btn btn-outline-success btn-sm" onclick="viewFinancialReport()">
                                Generate Report
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center p-3 border rounded">
                            <i class="fas fa-tachometer-alt fa-2x text-warning mb-2"></i>
                            <h5>Performance Metrics</h5>
                            <p class="text-muted">Processing times and efficiency</p>
                            <button class="btn btn-outline-warning btn-sm" onclick="viewPerformanceReport()">
                                Generate Report
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Claim Details Modal -->
<div class="modal fade" id="claimDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white">Claim Details & Final Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="managerClaimDetails">
                <!-- Details loaded via JavaScript -->
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusIcon(ContractClaimSystem.Models.ClaimStatus status)
    {
        return status switch
        {
            ContractClaimSystem.Models.ClaimStatus.Pending => "fa-clock",
            ContractClaimSystem.Models.ClaimStatus.UnderReview => "fa-search",
            ContractClaimSystem.Models.ClaimStatus.Approved => "fa-check-circle",
            ContractClaimSystem.Models.ClaimStatus.Rejected => "fa-times-circle",
            _ => "fa-question-circle"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Initialize charts when page loads
        document.addEventListener('DOMContentLoaded', function() {
            initializeStatusChart();
            initializeMonthlyTrendChart();
        });

        function initializeStatusChart() {
            const ctx = document.getElementById('statusChart').getContext('2d');
            const statusData = {
                labels: ['Pending', 'Under Review', 'Approved', 'Rejected'],
                datasets: [{
                    data: [
                        @Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Pending),
                        @Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.UnderReview),
                        @Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Approved),
                        @Model.Count(c => c.Status == ContractClaimSystem.Models.ClaimStatus.Rejected)
                    ],
                    backgroundColor: [
                        '#eab308', '#3b82f6', '#22c55e', '#ef4444'
                    ]
                }]
            };

            new Chart(ctx, {
                type: 'doughnut',
                data: statusData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        function initializeMonthlyTrendChart() {
            const ctx = document.getElementById('monthlyTrendChart').getContext('2d');

            // Sample data - in real app, this would come from the server
            const monthlyData = {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Claims Submitted',
                    data: [12, 19, 15, 17, 14, 16],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    fill: true
                }]
            };

            new Chart(ctx, {
                type: 'line',
                data: monthlyData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function loadClaimDetails(claimId) {
            // In a real application, this would fetch data from the server
            // For now, we'll show a placeholder
            const detailsContent = `
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Claim ID:</strong><br>
                        <span>#${claimId}</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Submitted Date:</strong><br>
                        <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="col-12 mb-3">
                        <strong>Full Description:</strong><br>
                        <p class="p-3 bg-light rounded">Detailed claim description would appear here with all supporting information and documents.</p>
                    </div>
                    <div class="col-12">
                        <strong>Final Approval Action:</strong><br>
                        <div class="mt-3">
                            <form asp-controller="Claims" asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="${claimId}" />
                                <input type="hidden" name="status" value="@ContractClaimSystem.Models.ClaimStatus.Approved" />
                                <button type="submit" class="btn btn-success me-2">
                                    <i class="fas fa-check me-1"></i>Approve Claim
                                </button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-1"></i>Close
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('managerClaimDetails').innerHTML = detailsContent;
        }

        function generateReport() {
            alert('System report generation started. This would generate a comprehensive PDF report in a real application.');
        }

        function viewLecturerReport() {
            alert('Lecturer Activity Report would be generated here.');
        }

        function viewFinancialReport() {
            alert('Financial Summary Report would be generated here.');
        }

        function viewPerformanceReport() {
            alert('Performance Metrics Report would be generated here.');
        }
    </script>
}